{
  "dashboard": {
    "id": "logfire-main-dashboard",
    "title": "Logfire – Application Overview",
    "description": "Dashboard principal de observabilidad (logs, métricas y trazas)",
    "timeRange": {
      "from": "now-24h",
      "to": "now"
    },
    "refreshInterval": "30s",
    "panels": [
      {
        "id": "requests_total",
        "type": "timeseries",
        "title": "Requests totales",
        "metric": "http.server.request.count",
        "aggregation": "sum",
        "groupBy": ["service.name"],
        "unit": "requests"
      },
      {
        "id": "latency_p95",
        "type": "timeseries",
        "title": "Latencia p95",
        "metric": "http.server.request.duration",
        "aggregation": "p95",
        "unit": "ms"
      },
      {
        "id": "error_rate",
        "type": "stat",
        "title": "Error rate (%)",
        "formula": {
          "expression": "(errors / total) * 100",
          "metrics": {
            "errors": {
              "metric": "http.server.request.count",
              "filter": "http.status_code >= 500",
              "aggregation": "sum"
            },
            "total": {
              "metric": "http.server.request.count",
              "aggregation": "sum"
            }
          }
        },
        "unit": "%"
      },
      {
        "id": "top_endpoints",
        "type": "table",
        "title": "Top endpoints por tráfico",
        "metric": "http.server.request.count",
        "aggregation": "sum",
        "groupBy": ["http.route"],
        "limit": 10
      },
      {
        "id": "slow_traces",
        "type": "trace_list",
        "title": "Trazas más lentas",
        "filter": "duration > 1000ms",
        "sort": "duration_desc",
        "limit": 20
      },
      {
        "id": "logs_errors",
        "type": "log_stream",
        "title": "Errores recientes",
        "filter": "level = 'error'",
        "limit": 50
      }
    ]
  }
}
